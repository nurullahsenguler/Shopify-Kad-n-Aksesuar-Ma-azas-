{% comment %}
  Luxury SaaS-Style Ultra-Modern Expanded Footer & VIP Newsletter (Mobile Grid & Centered)
{% endcomment %}

<footer class="luxury-footer-section" id="Footer-{{ section.id }}">
  <div class="footer-container">
    
    <!-- VIP NEWSLETTER CARD -->
    {% if section.settings.show_newsletter %}
      <div class="footer-newsletter-card">
        <div class="newsletter-content">
          {% if section.settings.newsletter_subheading != blank %}
            <span class="newsletter-subheading">{{ section.settings.newsletter_subheading }}</span>
          {% endif %}
          {% if section.settings.newsletter_title != blank %}
            <h3 class="newsletter-title">{{ section.settings.newsletter_title }}</h3>
          {% endif %}
          {% if section.settings.newsletter_text != blank %}
            <p class="newsletter-text">{{ section.settings.newsletter_text }}</p>
          {% endif %}
        </div>

        <div class="newsletter-form-wrapper">
          {% form 'customer', class: 'newsletter-form' %}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <div class="input-group">
              <input 
                type="email" 
                name="contact[email]" 
                class="newsletter-input" 
                placeholder="{{ section.settings.newsletter_placeholder | default: 'Enter your email address...' }}"
                required
                autocomplete="email"
              >
              <button type="submit" class="newsletter-btn" aria-label="Subscribe">
                <span>{{ section.settings.newsletter_btn_text | default: 'JOIN NOW' }}</span>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </button>
            </div>
            {% if form.posted_successfully? %}
              <p class="form-message success-msg">Welcome to our inner circle!</p>
            {% endif %}
          {% endform %}
        </div>
      </div>
    {% endif %}

    <!-- MAIN FOOTER GRID -->
    <div class="footer-main-grid">
      
      <!-- HERO BRAND COLUMN -->
      <div class="footer-brand-hero-col">
        <div class="footer-hero-card">
          {% if section.settings.brand_image != blank %}
            <div class="footer-img-wrapper">
              <img 
                src="{{ section.settings.brand_image | image_url: width: 800 }}" 
                alt="{{ shop.name }}" 
                class="footer-hero-img"
                loading="lazy"
                width="800"
                height="600"
              >
              <div class="footer-img-overlay"></div>
            </div>
          {% endif %}

          <div class="footer-hero-content">
            {% if section.settings.logo != blank %}
              <img 
                src="{{ section.settings.logo | image_url: width: 300 }}" 
                alt="{{ shop.name }}" 
                class="footer-logo"
                width="160"
                height="60"
              >
            {% else %}
              <h2 class="footer-brand-name">{{ section.settings.brand_name | default: shop.name }}</h2>
            {% endif %}

            {% if section.settings.brand_about != blank %}
              <p class="footer-brand-desc">{{ section.settings.brand_about }}</p>
            {% endif %}

            <!-- SOCIAL LINKS -->
            <div class="footer-social-links">
              {% if section.settings.social_instagram != blank %}
                <a href="{{ section.settings.social_instagram }}" target="_blank" rel="noopener" aria-label="Instagram" class="social-icon">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
                </a>
              {% endif %}
              {% if section.settings.social_x != blank %}
                <a href="{{ section.settings.social_x }}" target="_blank" rel="noopener" aria-label="X (Twitter)" class="social-icon">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"></path></svg>
                </a>
              {% endif %}
              {% if section.settings.social_pinterest != blank %}
                <a href="{{ section.settings.social_pinterest }}" target="_blank" rel="noopener" aria-label="Pinterest" class="social-icon">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2a10 10 0 0 0-3.16 19.49c-.09-.81-.17-2.06.04-2.95l1.24-5.26s-.31-.63-.31-1.56c0-1.46.85-2.55 1.9-2.55.9 0 1.33.67 1.33 1.48 0 .9-.57 2.26-.87 3.51-.25 1.05.53 1.91 1.57 1.91 1.88 0 3.33-1.98 3.33-4.84 0-2.53-1.82-4.3-4.41-4.3-3.01 0-4.78 2.26-4.78 4.59 0 .91.35 1.88.79 2.41a.34.34 0 0 1 .08.32l-.29 1.2c-.05.22-.17.27-.4.16-1.5-.7-2.44-2.89-2.44-4.65 0-3.78 2.75-7.26 7.93-7.26 4.16 0 7.4 2.97 7.4 6.94 0 4.14-2.61 7.47-6.23 7.47-1.22 0-2.36-.63-2.75-1.38l-.75 2.87c-.27 1.04-1 2.35-1.49 3.14A10 10 0 1 0 12 2z"></path></svg>
                </a>
              {% endif %}
              {% if section.settings.social_youtube != blank %}
                <a href="{{ section.settings.social_youtube }}" target="_blank" rel="noopener" aria-label="YouTube" class="social-icon">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"></path><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"></polygon></svg>
                </a>
              {% endif %}
            </div>
          </div>
        </div>
      </div>

      <!-- MENU COLUMNS -->
      <div class="footer-links-wrapper">
        {% for block in section.blocks %}
          {% if block.type == 'link_list' %}
            <div class="footer-menu-col" {{ block.shopify_attributes }}>
              {% if block.settings.title != blank %}
                <h4 class="menu-col-title">{{ block.settings.title }}</h4>
              {% endif %}
              
              {% assign footer_menu = linklists[block.settings.menu] %}
              {% if footer_menu.links.size > 0 %}
                <ul class="footer-menu-list">
                  {% for link in footer_menu.links %}
                    <li>
                      <a href="{{ link.url }}" class="footer-link">{{ link.title }}</a>
                    </li>
                  {% endfor %}
                </ul>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>

    </div>

    <!-- BOTTOM BAR -->
    <div class="footer-bottom-bar">
      <div class="copyright-text">
        &copy; {{ 'now' | date: '%Y' }} {{ section.settings.copyright_text | default: shop.name }}. All rights reserved.
      </div>

      {% if section.settings.show_payment_icons %}
        <div class="payment-icons">
          {% for type in shop.enabled_payment_types %}
            {{ type | payment_type_svg_tag: class: 'payment-svg' }}
          {% endfor %}
        </div>
      {% endif %}
    </div>

  </div>
</footer>

<style>
  #Footer-{{ section.id }},
  #Footer-{{ section.id }} * {
    box-sizing: border-box !important;
  }

  #Footer-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    padding: {{ section.settings.padding_top }}px 2rem 40px 2rem;
    position: relative;
    z-index: 15;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .footer-container {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 70px;
  }

  /* VIP NEWSLETTER GLASS CARD */
  .footer-newsletter-card {
    background: {{ section.settings.newsletter_bg_color }};
    border: 1px solid {{ section.settings.newsletter_border_color }};
    border-radius: 28px;
    padding: 50px 60px;
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 40px;
    align-items: center;
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.35);
  }

  .newsletter-subheading {
    display: block;
    font-size: 0.75rem;
    letter-spacing: 5px;
    text-transform: uppercase;
    color: {{ section.settings.accent_color }};
    margin-bottom: 10px;
    font-weight: 500;
  }

  .newsletter-title {
    font-size: 2.2rem;
    font-weight: 300;
    letter-spacing: 1px;
    color: {{ section.settings.newsletter_title_color }};
    margin: 0 0 10px 0;
  }

  .newsletter-text {
    font-size: 0.92rem;
    line-height: 1.6;
    color: {{ section.settings.newsletter_text_color }};
    margin: 0;
  }

  .input-group {
    display: flex;
    align-items: center;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 50px;
    padding: 6px 8px 6px 24px;
    transition: all 0.3s ease;
  }

  .input-group:focus-within {
    border-color: {{ section.settings.accent_color }};
    box-shadow: 0 0 25px rgba(229, 9, 20, 0.2);
  }

  .newsletter-input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    color: #ffffff;
    font-size: 0.92rem;
  }

  .newsletter-input::placeholder {
    color: rgba(255, 255, 255, 0.4);
  }

  .newsletter-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: {{ section.settings.btn_bg_color }};
    color: {{ section.settings.btn_text_color }};
    border: none;
    padding: 14px 28px;
    border-radius: 40px;
    cursor: pointer;
    font-size: 0.8rem;
    letter-spacing: 2px;
    text-transform: uppercase;
    font-weight: 600;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .newsletter-btn:hover {
    background: {{ section.settings.btn_hover_bg_color }};
    color: {{ section.settings.btn_hover_text_color }};
    transform: translateY(-2px);
    box-shadow: 0 10px 20px rgba(229, 9, 20, 0.3);
  }

  .form-message.success-msg {
    margin-top: 10px;
    color: #4ade80;
    font-size: 0.85rem;
  }

  /* MAIN GRID LAYOUT */
  .footer-main-grid {
    display: grid;
    grid-template-columns: 2.2fr 3fr;
    gap: 70px;
  }

  .footer-brand-hero-col {
    width: 100%;
  }

  .footer-hero-card {
    position: relative;
    border-radius: 24px;
    padding: 36px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 360px;
    transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .footer-hero-card:hover {
    border-color: {{ section.settings.accent_color }};
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.35);
  }

  .footer-img-wrapper {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    overflow: hidden;
  }

  .footer-hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1s cubic-bezier(0.16, 1, 0.3, 1);
    filter: brightness(0.6) contrast(1.1);
  }

  .footer-hero-card:hover .footer-hero-img {
    transform: scale(1.06);
  }

  .footer-img-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(180deg, rgba(10,10,10,0.2) 0%, rgba(10,10,10,0.9) 100%);
  }

  .footer-hero-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .footer-brand-name {
    font-size: 2rem;
    font-weight: 300;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: #ffffff;
    margin: 0;
  }

  .footer-brand-desc {
    font-size: 0.9rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.8);
    margin: 0;
  }

  /* SOCIAL ICONS */
  .footer-social-links {
    display: flex;
    gap: 12px;
    margin-top: 6px;
  }

  .social-icon {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    text-decoration: none;
    backdrop-filter: blur(8px);
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .social-icon:hover {
    background: {{ section.settings.accent_color }};
    color: #ffffff;
    border-color: {{ section.settings.accent_color }};
    transform: translateY(-4px) scale(1.05);
    box-shadow: 0 10px 20px rgba(229, 9, 20, 0.3);
  }

  /* MENU LINKS */
  .footer-links-wrapper {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
    align-content: center;
  }

  .menu-col-title {
    font-size: 0.82rem;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: {{ section.settings.heading_color }};
    margin: 0 0 24px 0;
    font-weight: 500;
  }

  .footer-menu-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .footer-link {
    color: {{ section.settings.text_color }};
    text-decoration: none;
    font-size: 0.9rem;
    transition: all 0.3s ease;
  }

  .footer-link:hover {
    color: {{ section.settings.accent_color }};
    padding-left: 6px;
  }

  /* BOTTOM BAR */
  .footer-bottom-bar {
    padding-top: 30px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.5);
  }

  .payment-icons {
    display: flex;
    gap: 10px;
  }

  .payment-svg {
    height: 24px;
    width: auto;
  }

  @media (max-width: 1024px) {
    .footer-newsletter-card { grid-template-columns: 1fr; padding: 40px; text-align: center; }
    .footer-main-grid { grid-template-columns: 1fr; gap: 40px; }
    .footer-links-wrapper { grid-template-columns: repeat(3, 1fr); text-align: center; }
  }

  /* MOBİLDE YAN YANA MENÜLER & TAM ORTALAMA */
  @media (max-width: 600px) {
    #Footer-{{ section.id }} { padding: 40px 1rem 30px 1rem; }
    .footer-container { gap: 45px; }
    
    .footer-newsletter-card { 
      padding: 30px 20px; 
      text-align: center; 
      gap: 24px;
    }

    .newsletter-title { font-size: 1.6rem; }

    .input-group { 
      flex-direction: column; 
      padding: 10px; 
      gap: 10px; 
      border-radius: 20px; 
    }
    .newsletter-btn { width: 100%; justify-content: center; }

    .footer-hero-card {
      min-height: 280px;
      padding: 24px 20px;
      text-align: center;
      align-items: center;
    }

    .footer-hero-content {
      align-items: center;
    }

    .footer-social-links {
      justify-content: center;
    }

    /* MENÜLERİ MOBİLDE YAN YANA (3 SÜTUN) DİZME & BOYUTLARI DENGELER */
    .footer-links-wrapper { 
      grid-template-columns: repeat(3, 1fr); 
      gap: 12px; 
      text-align: center;
    }

    .menu-col-title {
      font-size: 0.68rem;
      letter-spacing: 1.5px;
      margin-bottom: 14px;
    }

    .footer-menu-list {
      gap: 10px;
    }

    .footer-link {
      font-size: 0.78rem;
    }

    .footer-link:hover {
      padding-left: 0;
    }

    .footer-bottom-bar { 
      flex-direction: column; 
      gap: 16px; 
      text-align: center; 
    }
  }
</style>

