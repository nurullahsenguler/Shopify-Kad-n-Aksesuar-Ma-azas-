{% comment %}
  Luxury Minimalist Featured Products (Identical Card Sizes & Red Hover Buttons)
  - With Scroll Reveal Entry Animation
{% endcomment %}

<section class="featured-products-section" id="Products-{{ section.id }}">
  <div class="fp-container">
    
    <!-- HEADER AREA -->
    <div class="fp-header fp-entry-header">
      {% if section.settings.subheading != blank %}
        <span class="fp-subheading">{{ section.settings.subheading }}</span>
      {% endif %}
      {% if section.settings.title != blank %}
        <h2 class="fp-title">{{ section.settings.title }}</h2>
      {% endif %}

      <!-- TABS -->
      {% if section.blocks.size > 0 %}
        <div class="fp-tabs">
          {% for block in section.blocks %}
            {% assign collection = collections[block.settings.collection] %}
            <button 
              class="fp-tab-btn {% if forloop.first %}active{% endif %}" 
              data-tab="tab-{{ block.id }}"
              onclick="switchFpTab('{{ section.id }}', 'tab-{{ block.id }}', this)"
              {{ block.shopify_attributes }}
            >
              {{ block.settings.tab_title | default: collection.title | default: "Best Sellers" }}
            </button>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <!-- CONTENT GRIDS -->
    <div class="fp-content-wrapper fp-entry-grid">
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          {% assign collection = collections[block.settings.collection] %}
          {% assign limit = section.settings.products_limit | default: 4 %}

          <div 
            class="fp-tab-pane {% if forloop.first %}active{% endif %}" 
            id="tab-{{ block.id }}"
          >
            <div class="fp-grid">
              {% if collection != blank and collection.products.size > 0 %}
                {% for product in collection.products limit: limit %}
                  
                  <div class="fp-product-card" tabindex="0">
                    <div class="fp-image-wrapper">
                      <a href="{{ product.url }}" class="fp-image-link">
                        {% if product.featured_media %}
                          <img 
                            src="{{ product.featured_media | image_url: width: 600 }}" 
                            alt="{{ product.title | escape }}" 
                            loading="lazy" 
                            class="fp-img primary-img"
                            width="600"
                            height="800"
                          >
                        {% else %}
                          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg fp-img' }}
                        {% endif %}

                        {% if product.media[1] != blank and section.settings.show_secondary_image %}
                          <img 
                            src="{{ product.media[1] | image_url: width: 600 }}" 
                            alt="{{ product.title | escape }}" 
                            loading="lazy" 
                            class="fp-img secondary-img"
                            width="600"
                            height="800"
                          >
                        {% endif %}
                      </a>

                      {% if product.compare_at_price > product.price %}
                        <span class="fp-badge badge-sale">{{ section.settings.sale_badge_text | default: "Sale" }}</span>
                      {% elsif product.created_at %}
                        <span class="fp-badge badge-new">{{ section.settings.new_badge_text | default: "New" }}</span>
                      {% endif %}

                      <!-- HOVER BUTTON (KIRMIZI HOVER) -->
                      <div class="fp-card-actions">
                        <a href="{{ product.url }}" class="fp-action-btn">
                          <span>{{ section.settings.btn_text | default: "Quick View" }}</span>
                          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M5 12h14M12 5l7 7-7 7"/>
                          </svg>
                        </a>
                      </div>
                    </div>

                    <!-- PRODUCT DETAILS -->
                    <div class="fp-details">
                      <span class="fp-vendor">{{ product.vendor | default: section.settings.default_vendor }}</span>
                      <h3 class="fp-product-title">
                        <a href="{{ product.url }}">{{ product.title }}</a>
                      </h3>
                      <div class="fp-price-box">
                        {% if product.compare_at_price > product.price %}
                          <span class="fp-price compare-price">{{ product.compare_at_price | money }}</span>
                        {% endif %}
                        <span class="fp-price main-price">{{ product.price | money }}</span>
                      </div>
                    </div>
                  </div>

                {% endfor %}
              {% else %}
                <!-- DEMO CARDS -->
                {% for i in (1..limit) %}
                  <div class="fp-product-card" tabindex="0">
                    <div class="fp-image-wrapper">
                      {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg fp-img' }}
                      <span class="fp-badge badge-sale">{{ section.settings.sale_badge_text | default: "Sale" }}</span>
                      <div class="fp-card-actions">
                        <a href="#" class="fp-action-btn">
                          <span>{{ section.settings.btn_text | default: "Quick View" }}</span>
                          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M5 12h14M12 5l7 7-7 7"/>
                          </svg>
                        </a>
                      </div>
                    </div>
                    <div class="fp-details">
                      <span class="fp-vendor">{{ section.settings.default_vendor | default: "Luxury Collection" }}</span>
                      <h3 class="fp-product-title"><a href="#">Minimalist Diamond Ring #{{ i }}</a></h3>
                      <div class="fp-price-box">
                        <span class="fp-price main-price">$120.00</span>
                      </div>
                    </div>
                  </div>
                {% endfor %}
              {% endif %}
            </div>
          </div>
        {% endfor %}
      {% endif %}
    </div>

  </div>
</section>

<style>
  /* --- SCROLL REVEAL ANİMASYONLARI (KARTLAR SIRAYLA) --- */
  @keyframes fpHeaderSlide {
    0% {
      opacity: 0;
      transform: translateY(-30px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fpCardSlideUp {
    0% {
      opacity: 0;
      transform: translateY(50px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .featured-products-section.is-in-view .fp-reveal-header {
    animation: fpHeaderSlide 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  /* Sekme içindeki kartların sırayla (staggered) aşağıdan çıkması */
  .featured-products-section.is-in-view .fp-tab-pane.active .fp-product-card {
    animation: fpCardSlideUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    opacity: 0;
  }

  /* Her karta sırayla gecikme (delay) veriyoruz ki yağ gibi ard arda gelsinler */
  .featured-products-section.is-in-view .fp-tab-pane.active .fp-product-card:nth-child(1) { animation-delay: 0.1s; }
  .featured-products-section.is-in-view .fp-tab-pane.active .fp-product-card:nth-child(2) { animation-delay: 0.22s; }
  .featured-products-section.is-in-view .fp-tab-pane.active .fp-product-card:nth-child(3) { animation-delay: 0.34s; }
  .featured-products-section.is-in-view .fp-tab-pane.active .fp-product-card:nth-child(4) { animation-delay: 0.46s; }
  .featured-products-section.is-in-view .fp-tab-pane.active .fp-product-card:nth-child(5) { animation-delay: 0.58s; }
  .featured-products-section.is-in-view .fp-tab-pane.active .fp-product-card:nth-child(6) { animation-delay: 0.7s; }

  .fp-reveal-header {
    opacity: 0;
  }

  .fp-product-card {
    opacity: 0; /* Başlangıçta görünmez */
  }

  #Products-{{ section.id }},
  #Products-{{ section.id }} * {
    box-sizing: border-box !important;
  }

  #Products-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    padding: {{ section.settings.padding_top }}px 2rem {{ section.settings.padding_bottom }}px;
    overflow: hidden !important;
    width: 100%;
  }

  .fp-container {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    width: 100%;
  }

  .fp-header {
    text-align: center;
    margin-bottom: 45px;
  }

  .fp-subheading {
    display: block;
    font-size: 0.75rem;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: {{ section.settings.subheading_color }};
    margin-bottom: 8px;
    font-weight: 500;
  }

  .fp-title {
    font-size: 2.2rem;
    font-weight: 300;
    letter-spacing: 2px;
    color: {{ section.settings.title_color }};
    margin: 0 0 24px 0;
  }

  /* TABS */
  .fp-tabs {
    display: inline-flex;
    gap: 6px;
    background: {{ section.settings.tab_bg_color }};
    padding: 5px;
    border-radius: 40px;
    border: 1px solid {{ section.settings.tab_border_color }};
    flex-wrap: wrap;
    justify-content: center;
  }

  .fp-tab-btn {
    border: none;
    background: transparent;
    padding: 8px 22px;
    border-radius: 30px;
    font-size: 0.8rem;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: {{ section.settings.tab_text_color }};
    cursor: pointer;
    font-weight: 500;
    transition: all 0.3s ease;
  }

  .fp-tab-btn.active, .fp-tab-btn:hover {
    background: {{ section.settings.tab_active_bg_color }};
    color: {{ section.settings.tab_active_text_color }};
    box-shadow: 0 4px 15px rgba(0,0,0,0.15);
  }

  .fp-tab-pane {
    display: none;
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .fp-tab-pane.active {
    display: block;
    opacity: 1;
  }

  /* GRID YAPISI */
  .fp-grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: {{ section.settings.grid_gap }}px;
    width: 100%;
  }

  .fp-product-card {
    display: flex;
    flex-direction: column;
    width: 100%;
    background-color: transparent;
    border: none;
    padding: 0;
    outline: none;
    transition: transform 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
  }

  .fp-product-card:hover,
  .fp-product-card:focus-within {
    transform: translateY(-4px);
  }

  .fp-image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: {{ section.settings.image_aspect_ratio }};
    border-radius: {{ section.settings.image_border_radius }}px;
    overflow: hidden;
    background: #181818;
  }

  .fp-image-link {
    display: block;
    width: 100%;
    height: 100%;
  }

  .fp-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.165, 0.84, 0.44, 1), opacity 0.5s ease;
  }

  .secondary-img {
    position: absolute;
    top: 0;
    left: 0;
    opacity: 0;
  }

  .fp-product-card:hover .primary-img,
  .fp-product-card:focus-within .primary-img {
    {% if section.settings.show_secondary_image %} opacity: 0; {% else %} transform: scale(1.06); {% endif %}
  }

  .fp-product-card:hover .secondary-img,
  .fp-product-card:focus-within .secondary-img {
    opacity: 1;
    transform: scale(1.06);
  }

  /* ROZETLER */
  .fp-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    padding: 4px 10px;
    border-radius: 20px;
    font-size: 0.6rem;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    font-weight: 600;
    z-index: 2;
  }

  .badge-sale { background: {{ section.settings.sale_badge_bg }}; color: {{ section.settings.sale_badge_text_color }}; }
  .badge-new { background: {{ section.settings.new_badge_bg }}; color: {{ section.settings.new_badge_text_color }}; }

  .fp-card-actions {
    position: absolute;
    bottom: 12px;
    left: 12px;
    right: 12px;
    opacity: 0;
    transform: translateY(10px);
    transition: all 0.3s cubic-bezier(0.165, 0.84, 0.44, 1);
    z-index: 3;
    pointer-events: none;
  }

  .fp-product-card:hover .fp-card-actions,
  .fp-product-card:focus-within .fp-card-actions,
  .fp-product-card:active .fp-card-actions {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .fp-action-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    padding: 11px;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: 30px;
    text-decoration: none;
    color: #000000;
    font-size: 0.72rem;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    font-weight: 600;
    transition: all 0.3s ease;
  }

  .fp-action-btn:hover {
    background: #e50914 !important;
    color: #ffffff !important;
    border-color: #e50914 !important;
    box-shadow: 0 5px 15px rgba(229, 9, 20, 0.4);
  }

  .fp-details {
    padding-top: 14px;
    padding-bottom: 4px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 3px;
  }

  .fp-vendor {
    font-size: 0.65rem;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: {{ section.settings.vendor_color }};
    opacity: 0.8;
  }

  .fp-product-title {
    margin: 0;
    font-size: 0.92rem;
    font-weight: 300;
    letter-spacing: 0.5px;
    line-height: 1.35;
  }

  .fp-product-title a {
    text-decoration: none;
    color: {{ section.settings.product_title_color }};
    transition: color 0.2s ease;
  }

  .fp-product-title a:hover {
    color: {{ section.settings.product_title_hover_color }};
  }

  .fp-price-box {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-top: 2px;
  }

  .fp-price {
    font-size: 0.9rem;
    font-weight: 500;
    letter-spacing: 0.5px;
  }

  .main-price { color: {{ section.settings.price_color }}; }
  .compare-price { text-decoration: line-through; color: {{ section.settings.compare_price_color }}; font-size: 0.8rem; font-weight: 300; }

  @media (max-width: 1024px) {
    .fp-grid { 
      grid-template-columns: repeat(2, 1fr); 
      gap: 20px; 
    }
  }

  @media (max-width: 600px) {
    #Products-{{ section.id }} { 
      padding: 40px 1rem; 
    }

    .fp-title { 
      font-size: 1.75rem; 
    }

    .fp-grid { 
      grid-template-columns: repeat({{ section.settings.columns_mobile }}, 1fr); 
      gap: 16px; 
    }
  }
</style>

<script>
  function switchFpTab(sectionId, tabId, btn) {
    const container = document.getElementById(`Products-${sectionId}`);
    if (!container) return;

    const buttons = container.querySelectorAll('.fp-tab-btn');
    buttons.forEach(b => b.classList.remove('active'));
    btn.classList.add('active');

    const panes = container.querySelectorAll('.fp-tab-pane');
    panes.forEach(p => p.classList.remove('active'));

    const targetPane = document.getElementById(tabId);
    if (targetPane) {
      targetPane.classList.add('active');
    }
  }

  // SCROLL REVEAL OBSERVER
  document.addEventListener('DOMContentLoaded', () => {
    const sectionEl = document.getElementById('Products-{{ section.id }}');
    if (!sectionEl) return;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          sectionEl.classList.add('is-in-view');
          observer.unobserve(sectionEl);
        }
      });
    }, { threshold: 0.15 });

    observer.observe(sectionEl);
  });
</script>

