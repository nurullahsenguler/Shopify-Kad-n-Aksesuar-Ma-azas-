{% comment %}
  Luxury 3D Coverflow Infinite Carousel (Zero-Overflow Fixed)
  - Auto-play with Hold-to-Pause
  - Click any card to bring to center
  - Smooth Hero-Style Slide & Fade Entry Animation Included
{% endcomment %}

<section class="custom-collections-section" id="Collections-{{ section.id }}">
  <div class="collections-container">
    
    <!-- HEADER AREA (Hero Tarzı Yukarıdan Aşağıya Süzülme) -->
    <div class="collections-header carousel-entry-header">
      {% if section.settings.subheading != blank %}
        <span class="collections-subheading">{{ section.settings.subheading }}</span>
      {% endif %}
      {% if section.settings.title != blank %}
        <h2 class="collections-title">{{ section.settings.title }}</h2>
      {% endif %}
    </div>

    <!-- CAROUSEL WRAPPER (Yumuşak Büyüme ve Fade Girişi) -->
    <div class="carousel-wrapper carousel-entry-track" id="CarouselWrapper-{{ section.id }}">
      <button class="carousel-nav prev-btn" onclick="moveCarousel('{{ section.id }}', -1)" aria-label="Previous">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M15 18l-6-6 6-6"/>
        </svg>
      </button>

      <div class="carousel-track-container">
        <div class="carousel-track" id="Track-{{ section.id }}">
          {% for block in section.blocks %}
            {% assign collection = collections[block.settings.collection] %}
            
            <div 
              class="collection-card-3d" 
              data-index="{{ forloop.index0 }}" 
              onclick="handleCardClick('{{ section.id }}', {{ forloop.index0 }}, event)"
              {{ block.shopify_attributes }}
            >
              <div class="card-inner">
                
                <div class="card-image-wrapper">
                  {% if block.settings.image != blank %}
                    <img 
                      src="{{ block.settings.image | image_url: width: 1000 }}" 
                      alt="{{ block.settings.custom_title | default: collection.title }}" 
                      loading="lazy" 
                      class="card-img"
                    >
                  {% elsif collection.featured_image != blank %}
                    <img 
                      src="{{ collection.featured_image | image_url: width: 1000 }}" 
                      alt="{{ collection.title }}" 
                      loading="lazy" 
                      class="card-img"
                    >
                  {% else %}
                    {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg card-img' }}
                  {% endif %}
                  
                  <div class="card-overlay"></div>
                </div>

                <div class="card-content">
                  <span class="card-count">
                    {% if collection.products_count != blank %}
                      {{ collection.products_count }} Items
                    {% else %}
                      Exclusive Line
                    {% endif %}
                  </span>
                  <h3 class="card-title">
                    {{ block.settings.custom_title | default: collection.title | default: "Collection Title" }}
                  </h3>
                  <a href="{{ collection.url | default: '#' }}" class="card-action">
                    <span class="action-text">Discover</span>
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                      <path d="M5 12h14M12 5l7 7-7 7"/>
                    </svg>
                  </a>
                </div>

              </div>
            </div>
          {% endfor %}
        </div>
      </div>

      <button class="carousel-nav next-btn" onclick="moveCarousel('{{ section.id }}', 1)" aria-label="Next">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M9 18l6-6-6-6"/>
        </svg>
      </button>
    </div>

  </div>
</section>

<style>
  /* --- HERO TARZI AKICI GİRİŞ ANİMASYONLARI --- */
  @keyframes sectionHeaderSlide {
    0% {
      opacity: 0;
      transform: translateY(-30px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes carouselTrackZoom {
    0% {
      opacity: 0;
      transform: scale(0.95) translateY(40px);
    }
    100% {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  /* Scroll ile ekrana girince tetiklenen aktif sınıflar */
  .custom-collections-section.is-in-view .carousel-entry-header {
    animation: sectionHeaderSlide 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .custom-collections-section.is-in-view .carousel-entry-track {
    animation: carouselTrackZoom 0.9s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: 0.2s;
  }

  /* Başlangıçta görünmez tutuyoruz */
  .carousel-entry-header,
  .carousel-entry-track {
    opacity: 0;
  }

  /* BOX RESET AND OVERFLOW LOCK */
  #Collections-{{ section.id }},
  #Collections-{{ section.id }} * {
    box-sizing: border-box !important;
  }

  #Collections-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    padding: 80px 2rem;
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden !important;
    width: 100% !important;
    max-width: 100vw !important;
  }

  .collections-container {
    width: 100%;
    max-width: 1600px;
    margin: 0 auto;
    overflow: hidden;
  }

  .collections-header {
    text-align: center;
    margin-bottom: 50px;
  }

  .collections-subheading {
    display: block;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: 0.8rem;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: {{ section.settings.subheading_color }};
    margin-bottom: 12px;
    font-weight: 600;
  }

  .collections-title {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: clamp(1.8rem, 3vw, 2.8rem);
    font-weight: 300;
    letter-spacing: 2px;
    color: {{ section.settings.title_color }};
    margin: 0;
  }

  /* CAROUSEL LAYOUT */
  .carousel-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
  }

  .carousel-track-container {
    width: 100%;
    height: 500px;
    position: relative;
    perspective: 1200px;
    overflow: hidden !important;
  }

  .carousel-track {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  /* 3D CARD STYLES */
  .collection-card-3d {
    position: absolute;
    width: 340px;
    height: 420px;
    border-radius: 20px;
    overflow: hidden;
    transition: transform 0.65s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.65s ease, z-index 0.65s ease, box-shadow 0.4s ease;
    box-shadow: 0 20px 40px rgba(0,0,0,0.3);
    cursor: pointer;
    user-select: none;
    backdrop-filter: blur(5px);
  }

  .collection-card-3d:hover {
    box-shadow: 0 25px 50px rgba(124, 255, 196, 0.2);
  }

  @media (max-width: 768px) {
    .collection-card-3d {
      width: 280px;
      height: 360px;
    }
    .carousel-track-container {
      height: 420px;
    }
  }

  /* CARD INNER DESIGN */
  .card-inner {
    display: block;
    width: 100%;
    height: 100%;
    position: relative;
  }

  .card-image-wrapper {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .collection-card-3d:hover .card-img {
    transform: scale(1.08);
  }

  .card-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(180deg, rgba(0,0,0,0) 25%, rgba(0,0,0,0.85) 100%);
  }

  .card-content {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    padding: 32px 28px;
    box-sizing: border-box;
    z-index: 2;
    color: #ffffff;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .card-count {
    font-size: 0.72rem;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    opacity: 0.85;
    font-weight: 500;
  }

  .card-title {
    font-size: 1.5rem;
    font-weight: 400;
    margin: 0;
    letter-spacing: 1px;
  }

  .card-action {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 8px;
    opacity: 0.85;
    color: #ffffff;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .card-action:hover {
    opacity: 1;
    transform: translateX(4px);
  }

  .action-text {
    font-size: 0.8rem;
    letter-spacing: 2px;
    text-transform: uppercase;
    font-weight: 600;
  }

  /* NAVIGATION BUTTONS */
  .carousel-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #ffffff;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    transition: all 0.3s ease;
  }

  .carousel-nav:hover {
    background: #ffffff;
    color: #000000;
    transform: translateY(-50%) scale(1.08);
  }

  .prev-btn { left: 15px; }
  .next-btn { right: 15px; }
</style>

<script>
  (function() {
    const sectionId = '{{ section.id }}';
    let currentIndex = 0;
    let autoPlayTimer = null;
    const autoPlayInterval = 3500;

    function updateCarousel() {
      const track = document.getElementById(`Track-${sectionId}`);
      if(!track) return;
      const cards = track.querySelectorAll('.collection-card-3d');
      const total = cards.length;

      cards.forEach((card, i) => {
        let offset = i - currentIndex;
        if (offset > total / 2) offset -= total;
        if (offset < -total / 2) offset += total;

        if (offset === 0) {
          // CENTER CARD
          card.style.transform = 'translateX(0px) scale(1.05)';
          card.style.opacity = '1';
          card.style.zIndex = '5';
          card.style.pointerEvents = 'auto';
        } else if (offset === 1) {
          // RIGHT CARD
          card.style.transform = 'translateX(290px) scale(0.84) rotateY(-10deg)';
          card.style.opacity = '0.7';
          card.style.zIndex = '3';
          card.style.pointerEvents = 'auto';
        } else if (offset === -1) {
          // LEFT CARD
          card.style.transform = 'translateX(-290px) scale(0.84) rotateY(10deg)';
          card.style.opacity = '0.7';
          card.style.zIndex = '3';
          card.style.pointerEvents = 'auto';
        } else if (offset === 2 || offset === -total + 2) {
          // FAR RIGHT CARD
          card.style.transform = 'translateX(500px) scale(0.68) rotateY(-18deg)';
          card.style.opacity = '0.3';
          card.style.zIndex = '1';
          card.style.pointerEvents = 'auto';
        } else if (offset === -2 || offset === total - 2) {
          // FAR LEFT CARD
          card.style.transform = 'translateX(-500px) scale(0.68) rotateY(18deg)';
          card.style.opacity = '0.3';
          card.style.zIndex = '1';
          card.style.pointerEvents = 'auto';
        } else {
          // HIDDEN CARDS
          card.style.transform = 'translateX(0px) scale(0.4)';
          card.style.opacity = '0';
          card.style.zIndex = '0';
          card.style.pointerEvents = 'none';
        }
      });
    }

    function startAutoPlay() {
      stopAutoPlay();
      autoPlayTimer = setInterval(() => {
        window.moveCarousel(sectionId, 1, false);
      }, autoPlayInterval);
    }

    function stopAutoPlay() {
      if (autoPlayTimer) clearInterval(autoPlayTimer);
    }

    window.moveCarousel = function(id, direction, isManual = true) {
      if(id !== sectionId) return;
      const track = document.getElementById(`Track-${sectionId}`);
      if (!track) return;
      const total = track.querySelectorAll('.collection-card-3d').length;
      if (total === 0) return;
      
      currentIndex = (currentIndex + direction + total) % total;
      updateCarousel();

      if (isManual) {
        startAutoPlay();
      }
    };

    window.handleCardClick = function(id, cardIndex, event) {
      if(id !== sectionId) return;

      if (event.target.closest('.card-action')) {
        return;
      }

      if (cardIndex !== currentIndex) {
        event.preventDefault();
        currentIndex = cardIndex;
        updateCarousel();
        startAutoPlay();
      }
    };

    // SCROLL INTERSECTION OBSERVER FOR HERO-STYLE ENTRY ANIMATION
    function initScrollObserver() {
      const sectionEl = document.getElementById(`Collections-${sectionId}`);
      if (!sectionEl) return;

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            sectionEl.classList.add('is-in-view');
            observer.unobserve(sectionEl);
          }
        });
      }, { threshold: 0.15 });

      observer.observe(sectionEl);
    }

    document.addEventListener('DOMContentLoaded', () => {
      updateCarousel();
      startAutoPlay();
      initScrollObserver();

      const wrapper = document.getElementById(`CarouselWrapper-${sectionId}`);
      if (wrapper) {
        wrapper.addEventListener('mouseenter', stopAutoPlay);
        wrapper.addEventListener('mouseleave', startAutoPlay);

        wrapper.addEventListener('touchstart', stopAutoPlay, { passive: true });
        wrapper.addEventListener('touchend', startAutoPlay);
      }
    });

    if (window.Shopify && window.Shopify.designMode) {
      document.addEventListener('shopify:section:load', () => {
        updateCarousel();
        startAutoPlay();
        initScrollObserver();
      });
    }
  })();
</script>

{% schema %}
{
  "name": "3D Carousel Collections",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#0a0a0a"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "CURATED SELECTION"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading Color",
      "default": "#888888"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Explore Collections"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Heading Color",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection Card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Select Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Image (Optional)"
        },
        {
          "type": "text",
          "id": "custom_title",
          "label": "Custom Title"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "3D Carousel Collections",
      "blocks": [
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" }
      ]
    }
  ]
}
{% endschema %}