{% comment %}
  Luxury SaaS-Style Split Image with Text (Centered Content & Mobile Optimized + Hero Style Reveal)
{% endcomment %}

<section class="split-story-section" id="Story-{{ section.id }}">
  <div class="story-container story-layout-{{ section.settings.layout }}">
    <!-- IMAGE COLUMN (Soldan/Sağdan Akıcı Giriş) -->
    <div class="story-image-column story-reveal-image">
      <div class="story-image-wrapper story-ratio-{{ section.settings.image_ratio }}">
        {% if section.settings.image != blank %}
          <img
            src="{{ section.settings.image | image_url: width: 1200 }}"
            alt="{{ section.settings.title | escape }}"
            loading="lazy"
            class="story-img"
            width="1200"
            height="1200"
          >
        {% else %}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg story-img' }}
        {% endif %}

        {% if section.settings.show_glass_overlay %}
          <div class="story-glass-card">
            <span class="glass-number">{{ section.settings.glass_text_sub | default: 'EST. 2026' }}</span>
            <span class="glass-title">{{ section.settings.glass_text_main | default: 'TIMELESS ELEGANCE' }}</span>
          </div>
        {% endif %}
      </div>
    </div>

    <!-- CONTENT COLUMN (Yukarıdan Aşağıya Sırayla Akış) -->
    <div class="story-content-column">
      <div class="story-content-box">
        {% if section.settings.badge_text != blank %}
          <span class="story-badge story-text-item item-1">{{ section.settings.badge_text }}</span>
        {% endif %}

        {% if section.settings.title != blank %}
          <h2 class="story-title story-text-item item-2">{{ section.settings.title }}</h2>
        {% endif %}

        {% if section.settings.text != blank %}
          <div class="story-text story-text-item item-3">{{ section.settings.text }}</div>
        {% endif %}

        {% if section.settings.btn_label != blank %}
          <div class="story-action story-text-item item-4">
            <a href="{{ section.settings.btn_link | default: '#' }}" class="story-btn">
              <span>{{ section.settings.btn_label }}</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </a>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

<style>
  /* --- HERO TARZI GİRİŞ VE YAĞ GİBİ KAYMA ANİMASYONLARI --- */
  @keyframes storySlideImage {
    0% {
      opacity: 0;
      transform: translateX(-60px);
    }
    100% {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes storyTextSlideDown {
    0% {
      opacity: 0;
      transform: translateY(-25px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Scroll ile ekrana girdiğinde tetiklenen aktif sınıflar */
  .split-story-section.is-in-view .story-reveal-image {
    animation: storySlideImage 0.85s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .split-story-section.is-in-view .story-text-item {
    animation: storyTextSlideDown 0.65s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  /* Metinlerin sırayla (staggered) yağ gibi akması */
  .split-story-section.is-in-view .story-text-item.item-1 { animation-delay: 0.2s; }
  .split-story-section.is-in-view .story-text-item.item-2 { animation-delay: 0.35s; }
  .split-story-section.is-in-view .story-text-item.item-3 { animation-delay: 0.5s; }
  .split-story-section.is-in-view .story-text-item.item-4 { animation-delay: 0.65s; }

  /* Başlangıçta görünmez tutma */
  .story-reveal-image,
  .story-text-item {
    opacity: 0;
  }

  #Story-{{ section.id }},
  #Story-{{ section.id }} * {
    box-sizing: border-box !important;
  }

  #Story-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    padding: {{ section.settings.padding_top }}px 2rem {{ section.settings.padding_bottom }}px;
    position: relative;
    z-index: 12;
    overflow: hidden !important;
  }

  .story-container {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ section.settings.column_gap }}px;
    align-items: center;
  }

  /* LAYOUT POSITIONS */
  .story-layout-right .story-image-column {
    order: 2;
  }
  .story-layout-right .story-content-column {
    order: 1;
  }

  /* IMAGE STYLES */
  .story-image-column {
    position: relative;
    display: flex;
    justify-content: center;
  }

  .story-image-wrapper {
    position: relative;
    width: 100%;
    border-radius: {{ section.settings.image_border_radius }}px;
    overflow: hidden;
    background: #141414;
    border: 1px solid {{ section.settings.image_border_color }};
    box-shadow: 0 20px 40px rgba(0,0,0,0.3);
  }

  .story-ratio-portrait { aspect-ratio: 4 / 5; }
  .story-ratio-square { aspect-ratio: 1 / 1; }
  .story-ratio-landscape { aspect-ratio: 16 / 10; }

  .story-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.8s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .story-image-wrapper:hover .story-img {
    transform: scale(1.04);
  }

  /* GLASSMORPHISM CARD */
  .story-glass-card {
    position: absolute;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(18, 22, 26, 0.65);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    padding: 16px 28px;
    border-radius: 16px;
    color: #ffffff;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 4px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.4);
    width: max-content;
    max-width: 90%;
  }

  .glass-number {
    font-size: 0.7rem;
    letter-spacing: 2px;
    opacity: 0.8;
    text-transform: uppercase;
  }

  .glass-title {
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 1px;
    color: #ffffff;
  }

  /* CONTENT STYLES */
  .story-content-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 20px;
  }

  .story-badge {
    font-size: 0.75rem;
    letter-spacing: 4px;
    text-transform: uppercase;
    font-weight: 600;
    color: {{ section.settings.badge_color }};
  }

  .story-title {
    font-size: 2.8rem;
    font-weight: 300;
    line-height: 1.2;
    letter-spacing: 1px;
    color: {{ section.settings.title_color }};
    margin: 0;
  }

  .story-text {
    font-size: 1.05rem;
    line-height: 1.7;
    color: {{ section.settings.text_color }};
    font-weight: 400;
  }

  .story-text p {
    margin: 0 0 12px 0;
  }

  .story-text p:last-child {
    margin-bottom: 0;
  }

  .story-action {
    margin-top: 10px;
    display: flex;
    justify-content: center;
    width: 100%;
  }

  .story-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 16px 36px;
    background-color: {{ section.settings.btn_bg_color }};
    color: {{ section.settings.btn_text_color }};
    border-radius: 40px;
    text-decoration: none;
    font-size: 0.85rem;
    letter-spacing: 2px;
    text-transform: uppercase;
    font-weight: 600;
    transition: all 0.3s cubic-bezier(0.25, 1, 0.5, 1);
    box-shadow: 0 4px 15px rgba(0,0,0,0.2);
  }

  .story-btn:hover {
    background-color: {{ section.settings.btn_hover_bg_color }};
    color: {{ section.settings.btn_hover_text_color }};
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(229, 9, 20, 0.3);
  }

  /* RESPONSIVE LAYOUT */
  @media (max-width: 1024px) {
    #Story-{{ section.id }} { padding: 50px 1.5rem; }
    .story-container {
      grid-template-columns: 1fr;
      gap: 35px;
    }
    .story-layout-right .story-image-column { order: 1; }
    .story-layout-right .story-content-column { order: 2; }
    .story-title { font-size: 2.1rem; }
    .story-text { font-size: 0.95rem; }
    .story-glass-card {
      bottom: 20px;
      padding: 12px 20px;
    }
  }
</style>

<script>
  (function() {
    const sectionId = '{{ section.id }}';
    document.addEventListener('DOMContentLoaded', () => {
      const sectionEl = document.getElementById(`Story-${sectionId}`);
      if (!sectionEl) return;

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            sectionEl.classList.add('is-in-view');
            observer.unobserve(sectionEl);
          }
        });
      }, { threshold: 0.15 });

      observer.observe(sectionEl);
    });
  })();
</script>

{% schema %}
{
  "name": "Luxury Story & Banner",
  "settings": [
    {
      "type": "header",
      "content": "Section Layout & Spacing"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Image Alignment",
      "options": [
        { "value": "left", "label": "Image Left" },
        { "value": "right", "label": "Image Right" }
      ],
      "default": "left"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#0a0a0a"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Max Container Width",
      "default": 1400
    },
    {
      "type": "range",
      "id": "column_gap",
      "min": 30,
      "max": 100,
      "step": 10,
      "unit": "px",
      "label": "Column Gap",
      "default": 70
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 40,
      "max": 140,
      "step": 10,
      "unit": "px",
      "label": "Top Padding",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 40,
      "max": 140,
      "step": 10,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 100
    },
    {
      "type": "header",
      "content": "Image & Glassmorphism Settings"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Select Story Image"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image Aspect Ratio",
      "options": [
        { "value": "portrait", "label": "Portrait (4:5)" },
        { "value": "square", "label": "Square (1:1)" },
        { "value": "landscape", "label": "Landscape (16:10)" }
      ],
      "default": "portrait"
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Image Border Radius",
      "default": 24
    },
    {
      "type": "color",
      "id": "image_border_color",
      "label": "Image Border Color",
      "default": "rgba(255, 255, 255, 0.08)"
    },
    {
      "type": "checkbox",
      "id": "show_glass_overlay",
      "label": "Show Glassmorphism Badge",
      "default": true
    },
    {
      "type": "text",
      "id": "glass_text_sub",
      "label": "Glass Badge Subtitle",
      "default": "EST. 2026"
    },
    {
      "type": "text",
      "id": "glass_text_main",
      "label": "Glass Badge Main Title",
      "default": "TIMELESS ELEGANCE"
    },
    {
      "type": "header",
      "content": "Content & Typography (English)"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Top Badge Text",
      "default": "OUR STORY"
    },
    {
      "type": "color",
      "id": "badge_color",
      "label": "Top Badge Color",
      "default": "#e50914"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Main Title",
      "default": "Crafting Modern Luxury Essentials"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Main Title Color",
      "default": "#ffffff"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Description Paragraph",
      "default": "<p>We combine minimalist design principles with ultra-premium formulations and high-grade sustainable materials. Experience an elevated skincare regimen crafted for the modern lifestyle.</p>"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Description Text Color",
      "default": "#a3a3a3"
    },
    {
      "type": "header",
      "content": "Button Settings"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "DISCOVER OUR STORY"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "color",
      "id": "btn_bg_color",
      "label": "Button Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "btn_text_color",
      "label": "Button Text Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "btn_hover_bg_color",
      "label": "Button Hover Background Color",
      "default": "#e50914"
    },
    {
      "type": "color",
      "id": "btn_hover_text_color",
      "label": "Button Hover Text Color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Luxury Story & Banner"
    }
  ]
}
{% endschema %}