{% comment %}
  Luxury SaaS-Style Accordion FAQ Section with Independent Question Colors (Scroll Reveal Enriched)
{% endcomment %}

<section class="faq-section" id="FAQ-{{ section.id }}">
  <div class="faq-container">
    
    <!-- HEADER AREA -->
    <div class="faq-header faq-reveal-header">
      {% if section.settings.subheading != blank %}
        <span class="faq-subheading">{{ section.settings.subheading }}</span>
      {% endif %}
      {% if section.settings.title != blank %}
        <h2 class="faq-title">{{ section.settings.title }}</h2>
      {% endif %}
      {% if section.settings.description != blank %}
        <p class="faq-description">{{ section.settings.description }}</p>
      {% endif %}
    </div>

    <!-- ACCORDION LIST -->
    <div class="faq-accordion-wrapper">
      {% for block in section.blocks %}
        <div class="faq-item faq-reveal-item" {{ block.shopify_attributes }}>
          <button 
            type="button" 
            class="faq-question-btn" 
            onclick="toggleFaq(this)"
            aria-expanded="false"
          >
            <span class="faq-question-text">{{ block.settings.question }}</span>
            <span class="faq-icon-wrapper">
              <svg class="faq-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M12 5v14M5 12h14"/>
              </svg>
            </span>
          </button>
          <div class="faq-answer-panel">
            <div class="faq-answer-content">
              {{ block.settings.answer }}
            </div>
          </div>
        </div>
      {% endfor %}
    </div>

  </div>
</section>

<style>
  /* --- SCROLL REVEAL VE AKICI AKIŞ ANİMASYONLARI --- */
  @keyframes faqHeaderSlide {
    0% {
      opacity: 0;
      transform: translateY(-30px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes faqItemSlideUp {
    0% {
      opacity: 0;
      transform: translateY(40px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .faq-section.is-in-view .faq-reveal-header {
    animation: faqHeaderSlide 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .faq-section.is-in-view .faq-reveal-item {
    animation: faqItemSlideUp 0.75s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    opacity: 0;
  }

  /* Soruların sırayla (staggered delay) peş peşe süzülmesi */
  .faq-section.is-in-view .faq-reveal-item:nth-child(1) { animation-delay: 0.12s; }
  .faq-section.is-in-view .faq-reveal-item:nth-child(2) { animation-delay: 0.24s; }
  .faq-section.is-in-view .faq-reveal-item:nth-child(3) { animation-delay: 0.36s; }
  .faq-section.is-in-view .faq-reveal-item:nth-child(4) { animation-delay: 0.48s; }
  .faq-section.is-in-view .faq-reveal-item:nth-child(5) { animation-delay: 0.60s; }

  .faq-reveal-header,
  .faq-reveal-item {
    opacity: 0;
  }

  #FAQ-{{ section.id }},
  #FAQ-{{ section.id }} * {
    box-sizing: border-box !important;
  }

  #FAQ-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    padding: {{ section.settings.padding_top }}px 2rem {{ section.settings.padding_bottom }}px;
    position: relative;
    z-index: 14;
    overflow: hidden !important;
    border-top: 1px solid rgba(255,255,255,0.08);
  }

  .faq-container {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
  }

  .faq-header {
    text-align: center;
    margin-bottom: 50px;
  }

  .faq-subheading {
    display: block;
    font-size: 0.75rem;
    letter-spacing: 5px;
    text-transform: uppercase;
    color: {{ section.settings.subheading_color }};
    margin-bottom: 12px;
    font-weight: 500;
  }

  .faq-title {
    font-size: 2.4rem;
    font-weight: 300;
    letter-spacing: 2px;
    color: {{ section.settings.title_color }};
    margin: 0 0 16px 0;
  }

  .faq-description {
    font-size: 0.98rem;
    color: {{ section.settings.subheading_color }};
    margin: 0;
    line-height: 1.6;
  }

  /* ACCORDION STRUCTURE */
  .faq-accordion-wrapper {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .faq-item {
    background: {{ section.settings.card_bg_color }};
    border: 1px solid {{ section.settings.card_border_color }};
    border-radius: {{ section.settings.card_border_radius }}px;
    overflow: hidden;
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .faq-item.active {
    border-color: {{ section.settings.card_active_border_color }};
    box-shadow: 0 15px 35px -10px rgba(229, 9, 20, 0.12);
  }

  .faq-question-btn {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 24px 30px;
    background: transparent;
    border: none;
    cursor: pointer;
    text-align: left;
    outline: none;
  }

  .faq-question-text {
    font-size: 1.05rem;
    font-weight: 400;
    letter-spacing: 0.5px;
    color: {{ section.settings.question_color }};
    transition: color 0.3s ease;
  }

  .faq-item.active .faq-question-text {
    color: {{ section.settings.question_active_color }};
    font-weight: 500;
  }

  .faq-icon-wrapper {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: {{ section.settings.icon_bg_color }};
    color: {{ section.settings.question_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), background 0.3s ease, color 0.3s ease;
  }

  .faq-icon {
    transition: transform 0.4s ease;
  }

  .faq-item.active .faq-icon-wrapper {
    background: {{ section.settings.icon_active_bg_color }};
    color: {{ section.settings.icon_active_color }};
    transform: rotate(45deg);
  }

  .faq-answer-panel {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .faq-answer-content {
    padding: 0 30px 28px 30px;
    font-size: 0.95rem;
    line-height: 1.7;
    color: {{ section.settings.text_color }};
    font-weight: 400;
  }

  .faq-answer-content p {
    margin: 0 0 10px 0;
  }

  .faq-answer-content p:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 600px) {
    #FAQ-{{ section.id }} { padding: 50px 1rem; }
    .faq-question-btn { padding: 20px; }
    .faq-question-text { font-size: 0.98rem; }
    .faq-answer-content { padding: 0 20px 20px 20px; font-size: 0.9rem; }
  }
</style>

<script>
  function toggleFaq(button) {
    const item = button.closest('.faq-item');
    const panel = item.querySelector('.faq-answer-panel');
    const isActive = item.classList.contains('active');

    const allItems = document.querySelectorAll('.faq-item');
    allItems.forEach(i => {
      if (i !== item) {
        i.classList.remove('active');
        i.querySelector('.faq-question-btn').setAttribute('aria-expanded', 'false');
        i.querySelector('.faq-answer-panel').style.maxHeight = null;
      }
    });

    if (isActive) {
      item.classList.remove('active');
      button.setAttribute('aria-expanded', 'false');
      panel.style.maxHeight = null;
    } else {
      item.classList.add('active');
      button.setAttribute('aria-expanded', 'true');
      panel.style.maxHeight = panel.scrollHeight + "px";
    }
  }

  /* Scroll Observer for FAQ Reveal Animation */
  (function() {
    const sectionId = '{{ section.id }}';
    document.addEventListener('DOMContentLoaded', () => {
      const sectionEl = document.getElementById(`FAQ-${sectionId}`);
      if (!sectionEl) return;

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            sectionEl.classList.add('is-in-view');
            observer.unobserve(sectionEl);
          }
        });
      }, { threshold: 0.15 });

      observer.observe(sectionEl);
    });
  })();
</script>

