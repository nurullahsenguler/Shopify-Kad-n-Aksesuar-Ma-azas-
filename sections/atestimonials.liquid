    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading Color",
      "default": "#888888"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Main Title",
      "default": "Loved by Discerning Clients"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Main Title Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Card & Text Styling"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card Background Color",
      "default": "#141414"
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Card Border Color",
      "default": "rgba(255, 255, 255, 0.08)"
    },
    {
      "type": "color",
      "id": "card_hover_border_color",
      "label": "Card Hover Border Color",
      "default": "#e50914"
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Card Border Radius",
