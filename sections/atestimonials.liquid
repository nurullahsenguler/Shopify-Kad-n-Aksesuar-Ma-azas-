      "min": 12,
      "max": 40,
      "step": 4,
      "unit": "px",
      "label": "Grid Gap",
      "default": 28
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial Card",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "step": 1,
