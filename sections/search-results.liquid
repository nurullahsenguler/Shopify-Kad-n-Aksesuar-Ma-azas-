<script
  src="{{ 'results-list.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

<style>
  /* Dark Luxury Results Section */
  .modern-orange-results-section {
    background-color: #0a0a0a; /* Siyah Arka Plan */
    padding: 60px 0;
    min-height: 100vh;
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    color: #ffffff;
  }

  /* 3'lü Grid ve Simetri Ayarı */
  .modern-orange-results-section .grid {
    display: grid !important;
    grid-template-columns: repeat(3, 1fr) !important; /* Net 3 Ürün */
    gap: 30px !important;
    max-width: 1200px;
    margin: 0 auto !important;
    padding: 0 20px;
    list-style: none;
  }

  /* Kartların Kendisi (Koyu Glassmorphism) */
  .product-grid__item {
    background: #141414 !important;
    border: 1px solid rgba(255, 255, 255, 0.08) !important;
    border-radius: 30px !important;
    padding: 20px;
    height: 100% !important; /* Aynı Boy Garantisi */
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275), border-color 0.4s ease, box-shadow 0.4s ease;
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .product-grid__item:hover {
    transform: translateY(-10px) scale(1.02);
    border-color: #e50914 !important;
    box-shadow: 0 20px 50px rgba(229, 9, 20, 0.2);
  }

  /* Resimlerin Boyutu ve Oranı (Simetri İçin Şart) */
  .product-grid__item .card__media,
  .product-grid__item img {
    aspect-ratio: 3 / 4 !important; /* Tüm resimler dikey ve aynı boyda */
    object-fit: cover !important;
    border-radius: 20px !important;
    width: 100%;
    display: block;
  }

  /* Boş Sonuç Ekranı */
  .search-empty-state {
    text-align: center;
    color: white;
    padding: 100px 20px;
    max-width: 650px;
    margin: 0 auto;
    background: #141414;
    border-radius: 40px;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .search-empty-state h2 {
    font-size: clamp(28px, 4vw, 42px);
    font-weight: 300 !important;
    letter-spacing: 1px;
    margin-bottom: 16px;
  }

  .search-empty-state p {
    font-size: 1rem !important;
    color: #a3a3a3;
    line-height: 1.6;
    margin-bottom: 30px;
  }

  .search-empty-btn {
    display: inline-block;
    background: #e50914;
    color: #ffffff;
    padding: 16px 40px;
    border-radius: 50px;
    text-decoration: none;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    transition: all 0.4s ease;
  }

  .search-empty-btn:hover {
    background: #ffffff;
    color: #0a0a0a;
    transform: translateY(-3px);
    box-shadow: 0 10px 25px rgba(255, 255, 255, 0.2);
  }

  /* Filtre Alanı Düzenlemesi */
  .search-filters-wrapper {
    max-width: 1200px;
    margin: 0 auto 40px;
    padding: 0 20px;
  }

  /* Mobil Düzenlemeler */
  @media (max-width: 990px) {
    .modern-orange-results-section .grid {
      grid-template-columns: repeat(2, 1fr) !important;
    }
  }
  @media (max-width: 600px) {
    .modern-orange-results-section .grid {
      grid-template-columns: 1fr !important;
    }
  }
</style>

<div class="modern-orange-results-section">
  <div class="section-background color-{{ section.settings.color_scheme }}"></div>

  <results-list
    class="section product-grid-container spacing-style color-{{ section.settings.color_scheme }}"
    style="--padding-block-start: {{ section.settings.padding-block-start }}px; --padding-block-end: {{ section.settings.padding-block-end }}px;"
    section-id="{{ section.id }}"
    infinite-scroll="{{ section.settings.enable_infinite_scroll }}"
  >
    {% render 'skip-to-content-link', href: '#ResultsList', text: 'accessibility.skip_to_results_list' %}

    <div class="collection-wrapper">
      {% assign products_per_page = 24 %}

      {% if section.settings.enable_infinite_scroll == false %}
        {% assign products_per_page = section.settings.products_per_page %}
      {% endif %}

      {% paginate search.results by products_per_page %}
        {% if search.results_count > 0 %}
          <div class="search-filters-wrapper">
            {% content_for 'block',
              type: 'filters',
              id: 'filters',
              results: search,
              results_size: search.results_count
            %}
          </div>

          {% assign products = search.results | where: 'object_type', 'product' %}

          {% capture children %}
            {% for product in products %}
              <li
                id="{{ section.id }}-{{ product.id }}"
                class="product-grid__item"
                data-page="{{ paginate.current_page }}"
                data-product-id="{{ product.id }}"
                ref="cards[]"
              >
                {% content_for 'block', type: '_product-card', id: 'product-card', closest.product: product %}
              </li>
            {% endfor %}
          {% endcapture %}

          {% render 'product-grid',
            section: section,
            children: children,
            products: products,
            paginate: paginate,
            enable_infinite_scroll: section.settings.enable_infinite_scroll,
            title: title
          %}

        {% else %}
          <div class="search-empty-state">
            <h2>NO STYLE FOUND</h2>
            <p>Try searching for something else or browse our full jewelry collection.</p>
            <a
              href="/collections/all"
              class="search-empty-btn"
              >BROWSE ALL</a
            >
          </div>
        {% endif %}
      {% endpaginate %}
    </div>
  </results-list>
</div>

{% schema %}
{
  "name": "Modern Search Results",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_infinite_scroll",
      "label": "Auto-load products",
      "default": true
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 8,
      "max": 36,
      "step": 4,
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top Padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom Padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    }
  ]
}
{% endschema %}