{% comment %}
  CUSTOM PRODUCT RECOMMENDATIONS SECTION - LUXURY DARK STYLE
{% endcomment %}

<div class="custom-recommendations-wrapper" id="Recommendations-{{ section.id }}" data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.max_products }}">
  {% if recommendations.performed and recommendations.products_count > 0 %}
    <div class="recommendations-container">
      <h2 class="recommendations-title">{{ section.settings.heading }}</h2>
      
      <div class="recommendations-grid">
        {% for recommend_product in recommendations.products %}
          <div class="recommend-card">
            <a href="{{ recommend_product.url }}" class="recommend-card-link">
              <div class="recommend-img-wrapper">
                <img 
                  src="{{ recommend_product.featured_image | img_url: '600x' }}" 
                  alt="{{ recommend_product.title | escape }}"
                  loading="lazy"
                  class="recommend-img"
                >
              </div>
              <div class="recommend-info">
                <h3 class="recommend-product-title">{{ recommend_product.title }}</h3>
                <div class="recommend-price">{{ recommend_product.price | money }}</div>
              </div>
            </a>
          </div>
        {% endfor %}
      </div>
    </div>
  {% endif %}
</div>

<style>
  .custom-recommendations-wrapper {
    background-color: {{ section.settings.bg_color }};
    padding: 80px 20px;
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
  }

  .recommendations-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .recommendations-title {
    text-align: center;
    color: #ffffff;
    font-size: 28px;
    font-weight: 300;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 50px;
    position: relative;
  }

  .recommendations-title::after {
    content: "";
    display: block;
    width: 60px;
    height: 2px;
    background: {{ section.settings.accent_color }};
    margin: 15px auto 0;
  }

  .recommendations-grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns }}, 1fr);
    gap: 24px;
  }

  .recommend-card {
    background: {{ section.settings.card_bg }};
    border-radius: 20px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.08);
    transition: transform 0.4s ease, border-color 0.4s ease, box-shadow 0.4s ease;
  }

  .recommend-card:hover {
    transform: translateY(-6px);
    border-color: {{ section.settings.accent_color }};
    box-shadow: 0 15px 30px rgba(0,0,0,0.5);
  }

  .recommend-card-link {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .recommend-img-wrapper {
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: #000;
  }

  .recommend-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .recommend-card:hover .recommend-img {
    transform: scale(1.08);
  }

  .recommend-info {
    padding: 20px;
    text-align: left;
  }

  .recommend-product-title {
    font-size: 1rem;
    font-weight: 400;
    color: #ffffff;
    margin: 0 0 10px 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .recommend-price {
    font-size: 1.1rem;
    font-weight: 600;
    color: #ffffff;
  }

  @media (max-width: 900px) {
    .recommendations-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }
  }

  @media (max-width: 480px) {
    .recommendations-grid {
      grid-template-columns: repeat({{ section.settings.mobile_columns }}, 1fr);
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const wrapper = document.getElementById('Recommendations-{{ section.id }}');
    if (!wrapper) return;

    const requestUrl = wrapper.dataset.url;

    fetch(requestUrl)
      .then(response => response.text())
      .then(html => {
        const tempDiv = document.createElement('div');
        tempDiv.innerHTML = html;
        const recommendationsContent = tempDiv.querySelector('#Recommendations-{{ section.id }}');

        if (recommendationsContent && recommendationsContent.innerHTML.trim() !== '') {
          wrapper.innerHTML = recommendationsContent.innerHTML;
        }
      })
      .catch(e => console.error("Önerilen ürünler yüklenirken hata:", e));
  });
</script>

{% schema %}
{
  "name": "Önerilen Ürünler (Özel)",
  "templates": ["product"],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Başlık",
      "default": "You May Also Like"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "Maksimum Ürün Sayısı",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Masaüstü Sütun Sayısı",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Mobil Sütun Sayısı",
      "options": [
        { "value": "1", "label": "1 Sütun" },
        { "value": "2", "label": "2 Sütun" }
      ],
      "default": "2"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Arka Plan Rengi",
      "default": "#0a0a0a"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Kart Arka Plan Rengi",
      "default": "#141414"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Vurgu / Alt Çizgi Rengi",
      "default": "#e50914"
    }
  ],
  "presets": [
    {
      "name": "Önerilen Ürünler (Özel)"
    }
  ]
}
{% endschema %}