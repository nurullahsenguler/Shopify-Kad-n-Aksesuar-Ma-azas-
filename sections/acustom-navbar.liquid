{% comment %}
  Nurullah Fully Customizable Modern Navbar
{% endcomment %}

<style>
  /* --- YAG GİBİ İNİŞ ANİMASYONU --- */
  @keyframes slideDownNavbar {
    0% {
      transform: translateY(-100%);
      opacity: 0;
    }
    100% {
      transform: translateY(0);
      opacity: 1;
    }
  }

  /* Dynamically Styled Variables from Schema */
  :root {
    --nav-bg-color: {{ section.settings.bg_color }};
    --nav-border-color: {{ section.settings.border_color }};
    --nav-text-color: {{ section.settings.text_color }};
    --nav-hover-color: {{ section.settings.hover_color }};
    --nav-hover-line: {{ section.settings.hover_line_color }};
  }

  /* Reset & Body Safeguard */
  html, body {
    overflow-x: hidden;
    width: 100%;
    position: relative;
  }

  .custom-navbar-wrapper * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  .custom-navbar-wrapper {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    width: 100%;
    z-index: 9999;
    background-color: var(--nav-bg-color);
    border-bottom: 1px solid var(--nav-border-color);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    transition: background-color 0.3s ease, border-color 0.3s ease;
    
    /* Yağ Gibi İniş Animasyonu Entegrasyonu */
    animation: slideDownNavbar 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  /* MASAÜSTÜ CONTAINER (Aynen Korundu) */
  .navbar-container {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 20px;
    height: {{ section.settings.nav_height }}px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  /* LOGO */
  .navbar-logo a {
    color: var(--nav-text-color);
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-decoration: none;
    text-transform: uppercase;
    transition: opacity 0.3s ease, color 0.3s ease;
    display: flex;
    align-items: center;
  }

  .navbar-logo img {
    max-height: {{ section.settings.logo_max_height }}px;
    width: auto;
    object-fit: contain;
  }

  .navbar-logo a:hover {
    opacity: 0.85;
  }

  /* MASAÜSTÜ MENÜ */
  .navbar-links {
    display: flex;
    align-items: center;
    gap: 32px;
    list-style: none;
  }

  .navbar-links a {
    position: relative;
    color: var(--nav-text-color);
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 6px 0;
    transition: color 0.3s ease;
  }

  .navbar-links a:hover {
    color: var(--nav-hover-color);
  }

  .navbar-links a::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0%;
    height: 1.5px;
    background-color: var(--nav-hover-line);
    transition: width 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
  }

  .navbar-links a:hover::after {
    width: 100%;
  }

  /* SAĞ İKONLAR */
  .navbar-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .navbar-icon-btn {
    color: var(--nav-text-color);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    position: relative;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background-color: transparent;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .navbar-icon-btn:hover {
    color: var(--nav-hover-color);
    background-color: rgba(255, 255, 255, 0.1);
    transform: translateY(-2px);
  }

  .navbar-icon-btn:active {
    transform: translateY(0px) scale(0.95);
  }

  .navbar-icon-btn svg {
    width: 20px;
    height: 20px;
    stroke: currentColor;
    fill: none;
  }

  .cart-badge {
    position: absolute;
    top: 4px;
    right: 4px;
    background-color: var(--nav-hover-line);
    color: #000000;
    font-size: 0.65rem;
    font-weight: 700;
    height: 16px;
    min-width: 16px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 4px;
    box-shadow: 0 2px 5px rgba(0,0,0,0.3);
    transition: transform 0.3s ease;
  }

  .navbar-icon-btn:hover .cart-badge {
    transform: scale(1.1);
  }

  /* MOBİL HAMBURGER BUTONU (Masaüstünde Gizli) */
  .mobile-toggle-btn {
    display: none;
    background: none;
    border: none;
    color: var(--nav-text-color);
    cursor: pointer;
    padding: 8px;
    border-radius: 50%;
    transition: background-color 0.3s ease, color 0.3s ease;
  }

  .mobile-toggle-btn:hover {
    background-color: rgba(255, 255, 255, 0.1);
    color: var(--nav-hover-color);
  }

  .mobile-toggle-btn svg {
    width: 24px;
    height: 24px;
    stroke: currentColor;
    fill: none;
  }

  /* SOLDAN KAYARAK GELEN SAYDAM MOBİL DRAWER */
  .mobile-drawer {
    position: fixed;
    top: 0;
    left: -100%;
    width: 75%;
    max-width: 380px;
    height: 100vh;
    background: rgba(20, 20, 20, 0.55);
    backdrop-filter: blur(30px);
    -webkit-backdrop-filter: blur(30px);
    z-index: 10000;
    transition: left 0.5s cubic-bezier(0.77, 0, 0.175, 1);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow-x: hidden;
    border-right: 1px solid var(--nav-border-color);
  }

  .mobile-drawer.active {
    left: 0;
  }

  /* MOBİLDEKİ ÇARPI (Eski Sitendeki Hizasında) */
  .drawer-close-trigger {
    position: absolute;
    top: 24px;
    left: 24px;
    cursor: pointer;
    color: var(--nav-text-color);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4px;
    transition: color 0.3s ease;
  }

  .drawer-close-trigger:hover {
    color: var(--nav-hover-color);
  }

  .drawer-close-trigger svg {
    width: 24px;
    height: 24px;
    stroke: currentColor;
    fill: none;
  }

  /* MOBİL ÇEKMECE İÇİNDE ORTALANMIŞ LİNKLER VE HOVER ÇİZGİSİ */
  .mobile-drawer-links {
    list-style: none;
    padding: 0;
    margin: 0;
    width: 100%;
    text-align: center;
  }

  .mobile-drawer-links li {
    margin: 25px 0;
    display: flex;
    justify-content: center;
  }

  .mobile-drawer-links a {
    position: relative;
    color: var(--nav-text-color);
    font-size: 1.25rem;
    font-weight: 600;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    padding-bottom: 8px;
    transition: color 0.3s ease;
  }

  .mobile-drawer-links a:hover {
    color: var(--nav-hover-color);
  }

  .mobile-drawer-links a::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 0%;
    height: 2px;
    background-color: var(--nav-hover-line);
    transition: width 0.3s ease;
  }

  .mobile-drawer-links a:hover::after {
    width: 100%;
  }

  /* MOBİL ARKAPLAN KARARTMA (OVERLAY) */
  .drawer-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.4);
    z-index: 9000;
    display: none;
  }

  .drawer-overlay.active {
    display: block;
  }

  /* MOBİL KESİN DÜZEN (Grid 3 Eşit Parça) */
  @media screen and (max-width: 990px) {
    .navbar-container {
      display: grid !important;
      grid-template-columns: 1fr auto 1fr !important;
      align-items: center !important;
      padding: 0 16px !important;
    }

    .mobile-toggle-btn {
      display: inline-flex !important;
      grid-column: 1 !important;
      justify-self: start !important;
    }

    .navbar-logo {
      grid-column: 2 !important;
      justify-self: center !important;
      text-align: center !important;
    }

    .navbar-links-nav {
      display: none !important;
    }

    .navbar-actions {
      grid-column: 3 !important;
      justify-self: end !important;
    }
  }
</style>

<div class="custom-navbar-wrapper">
  <header class="navbar-container">
    
    <!-- SOL: Mobil Hamburger -->
    <button class="mobile-toggle-btn" id="menuToggleBtn" aria-label="Menüyü Aç/Kapat" onclick="toggleMobileMenu()">
      <svg viewBox="0 0 24 24" stroke-width="1.8">
        <line x1="4" y1="7" x2="20" y2="7"></line>
        <line x1="4" y1="12" x2="20" y2="12"></line>
        <line x1="4" y1="17" x2="20" y2="17"></line>
      </svg>
    </button>

    <!-- ORTA: Logo -->
    <div class="navbar-logo">
      <a href="{{ routes.root_url }}">
        {% if section.settings.logo_image != blank %}
          <img src="{{ section.settings.logo_image | image_url: width: 300 }}" alt="{{ shop.name }}" loading="lazy">
        {% else %}
          {{ section.settings.logo_text | default: shop.name }}
        {% endif %}
      </a>
    </div>

    <!-- Masaüstü Navigasyon (Mobilde Gizli) -->
    <nav class="navbar-links-nav">
      <ul class="navbar-links">
        {% assign selected_menu = section.settings.menu | default: 'main-menu' %}
        {% for link in linklists[selected_menu].links %}
          <li><a href="{{ link.url }}">{{ link.title }}</a></li>
        {% endfor %}
      </ul>
    </nav>

    <!-- SAĞ: İkonlar -->
    <div class="navbar-actions">
      {% if section.settings.show_search %}
        <a href="{{ routes.search_url }}" class="navbar-icon-btn" aria-label="Arama">
          <svg viewBox="0 0 24 24" stroke-width="1.8"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        </a>
      {% endif %}

      {% if section.settings.show_account %}
        <a href="{{ routes.account_url }}" class="navbar-icon-btn" aria-label="Hesabım">
          <svg viewBox="0 0 24 24" stroke-width="1.8"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        </a>
      {% endif %}

      <a href="{{ routes.cart_url }}" class="navbar-icon-btn" aria-label="Sepet">
        <svg viewBox="0 0 24 24" stroke-width="1.8"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
        {% if cart.item_count > 0 %}
          <span class="cart-badge">{{ cart.item_count }}</span>
        {% endif %}
      </a>
    </div>

  </header>

  <!-- SOLDAN KAYARAK GELEN SAYDAM MOBİL DRAWER -->
  <div class="mobile-drawer" id="mobileDrawer">
    <!-- ÇARPI BUTONU SOL ÜSTTE -->
    <div class="drawer-close-trigger" onclick="toggleMobileMenu()">
      <svg viewBox="0 0 24 24" stroke-width="2">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </div>

    <!-- MOBİLDE ORTALANMIŞ LİNKLER -->
    <ul class="mobile-drawer-links">
      {% assign selected_menu = section.settings.menu | default: 'main-menu' %}
      {% for link in linklists[selected_menu].links %}
        <li><a href="{{ link.url }}">{{ link.title }}</a></li>
      {% endfor %}
    </ul>
  </div>

  <!-- MOBİL KARARTMA ARKA PLANI -->
  <div class="drawer-overlay" id="drawerOverlay" onclick="toggleMobileMenu()"></div>
</div>

<script>
  function toggleMobileMenu() {
    const drawer = document.getElementById('mobileDrawer');
    const overlay = document.getElementById('drawerOverlay');

    drawer.classList.toggle('active');
    overlay.classList.toggle('active');

    document.body.style.overflow = drawer.classList.contains('active') ? 'hidden' : '';
  }
</script>

{% schema %}
{
  "name": "Nurullah Navbar",
  "settings": [
    {
      "type": "header",
      "content": "Menü & Navigasyon Ayarları"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Gösterilecek Menü",
      "default": "main-menu",
      "info": "Shopify Panel > Online Store > Navigation kısmında oluşturduğun menüyü seç."
    },
    {
      "type": "header",
      "content": "Logo Ayarları"
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo Metni (Resim Yoksa)",
      "default": "JEWELRY"
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Logo Resmi"
    },
    {
      "type": "range",
      "id": "logo_max_height",
      "min": 20,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Logo Yüksekliği",
      "default": 36
    },
    {
      "type": "header",
      "content": "Düzen & Ölçüler"
    },
    {
      "type": "range",
      "id": "nav_height",
      "min": 50,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Navbar hazırlandıktan sonraki yükseklik",
      "default": 70
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "label": "Maksimum Genişlik",
      "default": 1280
    },
    {
      "type": "header",
      "content": "Renk Ayarları"
    },
    {
      "type": "color_background",
      "id": "bg_color",
      "label": "Arka Plan Rengi",
      "default": "transparent"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Alt Çizgi (Border) Rengi",
      "default": "rgba(255, 255, 255, 0.2)"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Yazı ve İkon Rengi",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "hover_color",
      "label": "Hover (Üzerine Gelince) Yazı/İkon Rengi",
      "default": "#e5c158"
    },
    {
      "type": "color",
      "id": "hover_line_color",
      "label": "Hover Alt Çizgi & Rozet Rengi",
      "default": "#e5c158"
    },
    {
      "type": "header",
      "content": "İkon Ayarları"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Arama İkonunu Göster",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "Hesabım İkonunu Göster",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Nurullah Navbar"
    }
  ]
}
{% endschema %}